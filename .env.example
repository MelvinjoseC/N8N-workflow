# ==============================================================================
# n8n Production Deployment Environment Configuration Template
# ==============================================================================

# Core n8n Settings
N8N_HOST=n8n.example.com
N8N_PORT=5678
N8N_PROTOCOL=https
NODE_ENV=production
GENERIC_TIMEZONE=UTC

# Webhook URLs (Crucial for receiving webhook events from external sources)
WEBHOOK_URL=https://n8n.example.com/

# Security & Encryption
# IMPORTANT: Generate a cryptographically secure random key for production!
N8N_ENCRYPTION_KEY=super-secret-random-encryption-key-change-me

# User Management / Authentication
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin-secure-password-change-me

# Database Configuration (PostgreSQL is recommended for production)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n_db
DB_POSTGRESDB_USER=n8n_user
DB_POSTGRESDB_PASSWORD=secure-db-password-change-me

# Queue & Scalability Settings (Bull Queue with Redis backend)
# Set to 'queue' if running multiple worker instances, otherwise set to 'regular'
EXECUTIONS_MODE=regular
QUEUE_BULL_REDIS_HOST=redis
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_PASSWORD=secure-redis-password-change-me

# Security Hardening
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
