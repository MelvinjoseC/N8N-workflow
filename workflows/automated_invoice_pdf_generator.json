{
  "name": "Automated Invoice PDF Generator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "invoice-trigger",
        "options": {}
      },
      "id": "e1f2g3h4-i5j6-k7l8-m9n0-o1p2q3r4s5t6",
      "name": "Order Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.example.com/orders/{{ $json.body.order_id }}/items",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.INTERNAL_API_TOKEN || 'dummy_token' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "f2g3h4i5-j6k7-l8m9-n0o1-p2q3r4s5t6u7",
      "name": "Fetch Order Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const order = items[0].json;\nconst customer = order.customer || {};\nconst lineItems = order.items || [];\n\nlet subtotal = 0;\nlet itemsHtml = '';\n\nlineItems.forEach(item => {\n  const total = item.quantity * item.unit_price;\n  subtotal += total;\n  itemsHtml += `\n    <tr>\n      <td style=\"padding: 8px; border-bottom: 1px solid #ddd;\">${item.name}</td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #ddd; text-align: center;\">${item.quantity}</td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #ddd; text-align: right;\">$${item.unit_price.toFixed(2)}</td>\n      <td style=\"padding: 8px; border-bottom: 1px solid #ddd; text-align: right;\">$${total.toFixed(2)}</td>\n    </tr>`;\n});\n\nconst tax = subtotal * 0.1; // 10% tax\nconst total = subtotal + tax;\n\nconst htmlTemplate = `\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Invoice #${order.invoice_number}</title>\n</head>\n<body style=\"font-family: Arial, sans-serif; color: #333; margin: 40px;\">\n  <div style=\"text-align: right;\">\n    <h1 style=\"margin: 0; color: #4A90E2;\">INVOICE</h1>\n    <p>Invoice #: ${order.invoice_number}</p>\n    <p>Date: ${new Date().toLocaleDateString()}</p>\n  </div>\n  <div style=\"margin-top: 40px;\">\n    <h3>Billed To:</h3>\n    <p><strong>${customer.name}</strong></p>\n    <p>${customer.address || ''}</p>\n    <p>Email: ${customer.email || ''}</p>\n  </div>\n  <table style=\"width: 100%; margin-top: 40px; border-collapse: collapse;\">\n    <thead>\n      <tr style=\"background-color: #f2f2f2;\">\n        <th style=\"padding: 8px; text-align: left;\">Description</th>\n        <th style=\"padding: 8px; text-align: center; width: 10%;\">Qty</th>\n        <th style=\"padding: 8px; text-align: right; width: 15%;\">Unit Price</th>\n        <th style=\"padding: 8px; text-align: right; width: 15%;\">Total</th>\n      </tr>\n    </thead>\n    <tbody>\n      ${itemsHtml}\n    </tbody>\n  </table>\n  <div style=\"margin-top: 40px; text-align: right; font-size: 1.1em;\">\n    <p>Subtotal: $${subtotal.toFixed(2)}</p>\n    <p>Tax (10%): $${tax.toFixed(2)}</p>\n    <p><strong>Grand Total: $${total.toFixed(2)}</strong></p>\n  </div>\n</body>\n</html>`;\n\nreturn {\n  json: {\n    invoice_number: order.invoice_number,\n    customer_email: customer.email,\n    customer_name: customer.name,\n    html: htmlTemplate\n  }\n};"
      },
      "id": "g3h4i5j6-k7l8-m9n0-o1p2-q3r4s5t6u7v8",
      "name": "Generate Invoice HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        690,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://demo.gotenberg.dev/api/convert/html",
        "sendBody": true,
        "specifyBody": "multipart",
        "formData": {
          "parameter": [
            {
              "name": "files",
              "value": "={{ $json.html }}",
              "parameterType": "formFile",
              "fileName": "index.html"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "h4i5j6k7-l8m9-n0o1-p2q3-r4s5t6u7v8w9",
      "name": "HTML to PDF Converter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        910,
        300
      ]
    },
    {
      "parameters": {
        "operation": "upload",
        "bucketName": "company-invoices-bucket",
        "fileName": "=invoices/{{ $('Generate Invoice HTML').item.json.invoice_number }}.pdf",
        "binaryPropertyName": "data",
        "additionalFields": {}
      },
      "id": "i5j6k7l8-m9n0-o1p2-q3r4-s5t6u7v8w9x0",
      "name": "Upload to AWS S3",
      "type": "n8n-nodes-base.awsS3",
      "typeVersion": 1,
      "position": [
        1130,
        200
      ],
      "credentials": {
        "aws": {
          "id": "dummy_aws_credential_id",
          "name": "S3 Access Keys"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "invoices@company.com",
        "toEmail": "={{ $('Generate Invoice HTML').item.json.customer_email }}",
        "subject": "=Invoice for Order #{{ $('Generate Invoice HTML').item.json.invoice_number }}",
        "html": "=Dear {{ $('Generate Invoice HTML').item.json.customer_name }},<br><br>Please find attached your invoice #{{ $('Generate Invoice HTML').item.json.invoice_number }}.<br><br>Thank you for your business!",
        "attachments": "data",
        "options": {}
      },
      "id": "j6k7l8m9-n0o1-p2q3-r4s5-t6u7v8w9x0y1",
      "name": "Email Invoice to Customer",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        1350,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "dummy_smtp_credential_id",
          "name": "Mailgun SMTP"
        }
      }
    }
  ],
  "connections": {
    "Order Webhook Trigger": {
      "main": [
        [
          {
            "node": "Fetch Order Details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Order Details": {
      "main": [
        [
          {
            "node": "Generate Invoice HTML",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Invoice HTML": {
      "main": [
        [
          {
            "node": "HTML to PDF Converter",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTML to PDF Converter": {
      "main": [
        [
          {
            "node": "Upload to AWS S3",
            "type": "main",
            "index": 0
          },
          {
            "node": "Email Invoice to Customer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload to AWS S3": {
      "main": [
        [
          {
            "node": "Email Invoice to Customer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "errorWorkflow": "e2c342f0-104c-4a37-b4d4-5397f0a71ad1"
  },
  "meta": {
