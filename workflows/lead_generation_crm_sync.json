{
  "name": "Lead Generation & CRM Sync",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-webhook",
        "options": {}
      },
      "id": "1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = items[0].json;\n\n// Basic data cleaning and validation\nconst cleanName = (item.name || 'Anonymous').trim().replace(/\\b\\w/g, c => c.toUpperCase());\nconst cleanEmail = (item.email || '').trim().toLowerCase();\nconst cleanCompany = (item.company || 'Self-Employed').trim();\nconst cleanPhone = (item.phone || '').replace(/[^0-9+]/g, '');\n\nif (!cleanEmail.includes('@')) {\n  throw new Error('Invalid email address format.');\n}\n\nreturn {\n  json: {\n    original_data: item,\n    lead: {\n      name: cleanName,\n      email: cleanEmail,\n      company: cleanCompany,\n      phone: cleanPhone,\n      message: item.message || ''\n    }\n  }\n};"
      },
      "id": "2b3c4d5e-6f7a-8b9c-0d1e-2f3a4b5c6d7e",
      "name": "Validate & Format Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.hubapi.com/crm/v3/objects/contacts/{{ $json.lead.email }}",
        "sendQueryParameters": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "idProperty",
              "value": "email"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.HUBSPOT_API_KEY || 'dummy_api_key' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "3c4d5e6f-7a8b-9c0d-1e2f-3a4b5c6d7e8f",
      "name": "Find HubSpot Contact",
