        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"properties\": {\"email\": \"{{ $('Validate & Format Data').item.json.lead.email }}\", \"firstname\": \"{{ $('Validate & Format Data').item.json.lead.name.split(' ')[0] }}\", \"lastname\": \"{{ $('Validate & Format Data').item.json.lead.name.split(' ').slice(1).join(' ') }}\", \"company\": \"{{ $('Validate & Format Data').item.json.lead.company }}\", \"phone\": \"{{ $('Validate & Format Data').item.json.lead.phone }}\"}}",
        "options": {}
      },
      "id": "5e6f7a8b-9c0d-1e2f-3a4b-5c6d7e8f9a0b",
